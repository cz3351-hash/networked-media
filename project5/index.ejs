<html>
<head>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <div class="sun-side">
    <img src="/images/sun.PNG" alt="" class="sun-img" />
    <a href="/about" class="aboutPg">about</a>
  </div>

  <div class="page">
    <div class="tree" id="tree"></div>
    <div id="groundPixels"></div>
  </div>
  <textarea id="leafNamesText" hidden><%= leafNamesText %></textarea>

  <div id="popupName" class="popup-bg">
    <div id="popupBg" class="popup-content">
      <h2 class="popup-header">Fallen Leaf!</h2>
      <p class="popup-text">Oops!
        <br><br>You blew a leaf down the tree. Please give it a name to keep it yours only, and alive</p>
      <img id="popupLeafImg" class="popup-leaf" src="<%= randomLeaf %>" alt="Random leaf">
      <form class="popup-enter" id="leafForm" method="POST" action="/save-leaf">
        <input type="text" id="leafName" placeholder="... leaf name" name="leafName" required>
        <input type="hidden" name="image" id="leafImage" value="<%= randomLeaf %>">
        <input type="submit" value="submit">
      </form>
    </div>
  </div>

  <script src="/main.js"></script>
</body>
</html>
